PORT=4000
# Comma-separated list of allowed frontend origins. Leave unset to allow all (fine for local dev).
CORS_ORIGIN=https://your-app-name.netlify.app
# HTTP Basic Auth required on every /api request. Leave APP_PASSWORD unset to
# disable the gate (NOT recommended once the app URL is shared).
APP_USERNAME=valor
APP_PASSWORD=choose-your-own-password-here
